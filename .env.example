# Copying this file is not sufficient. Run `make bootstrap` to generate secrets.
PFA_TIMEZONE=Europe/Amsterdam
PFA_GATEWAY_PORT=8000
PFA_FIREFLY_PORT=8080
PFA_IMPORTER_PORT=8081
PFA_IMPORTER_HTTPS_PORT=8444
PFA_GHOSTFOLIO_PORT=3333
PFA_LOG_LEVEL=INFO
PFA_DEMO_MODE=false
PFA_DATABASE_PATH=/var/lib/pfa/assistant.sqlite3
PFA_CODEX_TOOLS_ENABLED=false
PFA_RESEARCH_ENABLED=false
PFA_RESEARCH_CACHE_PATH=/var/lib/pfa/research-cache.sqlite3
# Identify this application responsibly to public providers; add owner contact if used.
PFA_RESEARCH_USER_AGENT=personal-finance-assistant/0.1 (https://github.com/giedrius-at-home/personal-finance-assistant)
PFA_OLLAMA_BASE_URL=http://host.docker.internal:11434
PFA_OLLAMA_MODEL=qwen3:8b

FIREFLY_SITE_OWNER=owner@example.invalid
FIREFLY_APP_KEY=__GENERATE_32_HEX__
FIREFLY_CRON_TOKEN=__GENERATE_32_HEX__
FIREFLY_DB_PASSWORD=__GENERATE_32_HEX__
# Used only by the assistant's read-only client after synthetic onboarding.
PFA_FIREFLY_API_TOKEN=
# Poll Firefly immediately at gateway startup and then once per interval.
PFA_FIREFLY_SYNC_ENABLED=false
PFA_FIREFLY_SYNC_INTERVAL_SECONDS=86400
# Optional comma-separated names used to recognize transfers between your accounts.
PFA_OWNER_NAME_ALIASES=
# Set to the random 24-character secret issued by Firefly after webhook creation.
PFA_FIREFLY_WEBHOOK_SECRET=

# Dedicated Data Importer credentials. Never reuse the dashboard token.
PFA_IMPORTER_FIREFLY_ACCESS_TOKEN=
PFA_ENABLE_BANKING_APP_ID=
# Leave empty until credentials/enable-banking.pem exists with mode 0600.
PFA_ENABLE_BANKING_PRIVATE_KEY_PATH=

GHOSTFOLIO_DB_PASSWORD=__GENERATE_32_HEX__
GHOSTFOLIO_REDIS_PASSWORD=__GENERATE_32_HEX__
GHOSTFOLIO_ACCESS_TOKEN_SALT=__GENERATE_64_HEX__
GHOSTFOLIO_JWT_SECRET_KEY=__GENERATE_64_HEX__
# Pinned 3.65.0 contract identity; rotate before its 180-day expiry.
PFA_GHOSTFOLIO_BEARER_TOKEN=
