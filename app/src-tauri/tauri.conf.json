{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finance",
  "version": "0.1.0",
  "identifier": "local.giedrius.finance",
  "build": {
    "beforeDevCommand": "cd ui && trunk serve",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "cd ui && trunk build --release",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Finance",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true,
        "maximizable": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "public.app-category.finance",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2NDIzMDRBMEY4QzJDMTkKUldRWkxJd1BTakJDZHJHa2dhK2lESE1HUzc5anN4alNIQUd5QnJzbHo5eDVzNjJPcHIxeTFGM1MK",
      "endpoints": []
    }
  }
}
