{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call the finance commands (reads, and the owner's edits) and drag itself.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "allow-dashboard",
    "allow-review",
    "allow-search-transactions",
    "allow-refresh",
    "allow-save-budget-plan",
    "allow-status",
    "allow-update-status",
    "allow-check-for-updates",
    "allow-install-update",
    "allow-set-release-token",
    "allow-forget-release-token",
    "allow-personal-transactions",
    "allow-save-personal-choice",
    "allow-set-transaction-category",
    "allow-review-decisions",
    "allow-review-batch",
    "allow-review-category-options",
    "allow-save-review-details",
    "allow-audit-daily-review",
    "allow-preview-consolidation",
    "allow-apply-consolidation",
    "core:event:default"
  ]
}
