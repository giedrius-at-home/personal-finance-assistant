    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "allow-dashboard",
    "allow-review",
    "allow-search-transactions",
    "allow-refresh",
    "allow-save-budget-plan",
    "allow-save-spending-group",
    "allow-create-spending-group",
    "allow-status",
    "allow-update-status",
    "allow-check-for-updates",
    "allow-install-update",
    "allow-set-release-token",
    "allow-forget-release-token",
    "allow-create-bill",
    "allow-edit-bill",
    "allow-archive-bill",
    "allow-save-subscription-categories",
    "allow-link-bill-payment",
    "allow-decline-bill-match",
    "allow-create-planned-payment",
    "allow-archive-planned-payment",
    "allow-closure",
    "allow-closure-action",
    "allow-closure-pots",
    "allow-save-pot",
    "allow-save-account-role",
    "allow-unclassified-accounts",
