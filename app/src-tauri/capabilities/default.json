{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call the finance read commands and drag itself.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "allow-overview",
    "allow-accounts",
    "allow-facets",
    "allow-transactions",
    "allow-category-totals",
    "allow-status",
    "allow-update-status",
    "allow-check-for-updates",
    "allow-install-update",
    "allow-set-release-token",
    "allow-forget-release-token",
    "core:event:default"
  ]
}
