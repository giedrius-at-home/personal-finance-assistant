    "allow-apply-settings",
    "allow-rollback-settings",
    "allow-personal-transactions",
    "allow-save-personal-choice",
    "allow-set-transaction-category",
    "allow-review-decisions",
    "allow-review-batch",
    "allow-review-category-options",
    "allow-save-review-details",
    "allow-audit-daily-review",
