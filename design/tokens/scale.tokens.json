{
  "scale": {
    "radius": {
      "$type": "dimension",
      "sm":   { "$value": { "value": 8, "unit": "px" } },
      "md":   { "$value": { "value": 12, "unit": "px" } },
      "lg":   { "$value": { "value": 14, "unit": "px" } },
      "xl":   { "$value": { "value": 20, "unit": "px" } },
      "2xl":  { "$value": { "value": 30, "unit": "px" } },
      "pill": { "$value": { "value": 9999, "unit": "px" } }
    },
    "text": {
      "$type": "dimension",
      "eyebrow": { "$value": { "value": 0.62, "unit": "rem" } },
      "xs":      { "$value": { "value": 0.72, "unit": "rem" } },
      "sm":      { "$value": { "value": 0.82, "unit": "rem" } },
      "base":    { "$value": { "value": 0.9, "unit": "rem" } },
      "lg":      { "$value": { "value": 1.05, "unit": "rem" } },
      "xl":      { "$value": { "value": 1.3, "unit": "rem" } },
      "2xl":     { "$value": { "value": 1.7, "unit": "rem" } },
      "display": { "$value": { "value": 2.4, "unit": "rem" } }
    },
    "tracking": {
      "$type": "dimension",
      "tight":   { "$value": { "value": -0.02, "unit": "em" } },
      "normal":  { "$value": { "value": 0, "unit": "em" } },
      "wide":    { "$value": { "value": 0.04, "unit": "em" } },
      "eyebrow": { "$value": { "value": 0.14, "unit": "em" } }
    },
    "font": {
      "$type": "fontFamily",
      "sans": { "$value": ["Manrope Variable", "Inter", "system-ui", "sans-serif"] }
    },
    "shadow": {
      "$type": "shadow",
      "xs": {
        "$value": {
          "color": { "colorSpace": "oklch", "components": [0.2508, 0.0055, 106.79], "alpha": 0.08 },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 1, "unit": "px" },
          "blur": { "value": 5, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      },
      "pop": {
        "$value": {
          "color": { "colorSpace": "oklch", "components": [0.2132, 0.0042, 264.48], "alpha": 0.14 },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 8, "unit": "px" },
          "blur": { "value": 24, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      }
    },
    "ease": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] }
    },
    "duration": {
      "$type": "duration",
      "fast": { "$value": { "value": 120, "unit": "ms" } },
      "base": { "$value": { "value": 200, "unit": "ms" } }
    }
  }
}
